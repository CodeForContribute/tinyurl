# Local development. On App Platform these come from .do/app.yaml instead.
DATABASE_URL=postgresql://tinyurl:tinyurl@localhost:5432/tinyurl
BASE_URL=http://localhost:8080
LOG_LEVEL=INFO
RATE_LIMIT_REQUESTS=20
RATE_LIMIT_WINDOW_SECONDS=60
# Local runs have no proxy in front; App Platform sets this to 1.
TRUSTED_PROXY_HOPS=0

# Enables DELETE /api/links/{code}. Unset means the endpoint returns 503.
ADMIN_TOKEN=
